# ==============================================================================
# TenantShield - Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   copy .env.example .env (Windows PowerShell or Command Prompt)
# DO NOT commit .env into version control.
# ==============================================================================

# Application Settings
APP_ENV=development
ENVIRONMENT=development
DEBUG=true
APP_NAME=TenantShield
APP_VERSION=0.1.0
HOST=127.0.0.1
PORT=8000

# Security Control Switches (Default: true; can only be disabled if APP_ENV=lab)
ENABLE_APP_OWNERSHIP_CHECK=true
ENABLE_DB_RLS=true

# PostgreSQL Configuration
# Note: On systems with native Windows PostgreSQL installed, port is 5432.
# When running via Docker Compose, host port defaults to 5433 to avoid port collisions.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tenantshield_db

# Database Roles:
# 1. Administrator (used ONLY by init_db and administrative seeding)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_password
POSTGRES_ADMIN_URL=postgresql+psycopg://postgres:postgres_password@localhost:5432/tenantshield_db

# 2. Restricted Application Role (used by runtime application and tests)
# Enforces Row-Level Security (RLS) with NOSUPERUSER and NOBYPASSRLS privileges.
POSTGRES_APP_USER=tenantshield_app
POSTGRES_APP_PASSWORD=change_this_secure_password
DATABASE_URL=postgresql+asyncpg://tenantshield_app:change_this_secure_password@localhost:5432/tenantshield_db
DATABASE_URL_SYNC=postgresql+psycopg://tenantshield_app:change_this_secure_password@localhost:5432/tenantshield_db
LAB_DATABASE_URL=postgresql+asyncpg://tenantshield_app:change_this_secure_password@localhost:5432/tenantshield_lab

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis Cache & Rate Limiting Configuration (Docker / Local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication
SECRET_KEY=change_this_to_a_secure_random_key_with_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Envelope Encryption (Level 5)
# 256-bit AES-GCM Master Key (KEK) represented as 64 hexadecimal characters.
# Never commit the production master key or store it in the database.
TENANTSHIELD_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Development Seed Credentials (Used only by scripts/seed_tenants.py)
DEV_ACME_USER_EMAIL=acme_user@acme.test
DEV_ACME_USER_PASSWORD=AcmeSecretPassword123!
DEV_BETA_USER_EMAIL=beta_user@beta.test
DEV_BETA_USER_PASSWORD=BetaSecretPassword123!
DEV_ADMIN_USER_EMAIL=admin@tenantshield.test
DEV_ADMIN_USER_PASSWORD=PlatformAdminPassword123!
